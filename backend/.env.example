PORT=4000
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/swasthai
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*
# Required by GET /weather/current. Keep the real key only in backend/.env.
OPENWEATHER_API_KEY=replace-with-your-openweather-api-key
# Optional: configure Twilio to deliver SOS notifications automatically.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# WhatsApp sender configured in Twilio, e.g. whatsapp:+14155238886 for the sandbox.
TWILIO_WHATSAPP_FROM=
# Used only when a contact was entered without a leading +country code.
DEFAULT_PHONE_COUNTRY_CODE=+91
